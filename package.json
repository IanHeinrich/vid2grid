{
  "name": "vid2grid",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.scripts.json",
    "build": "npm run typecheck && npm run build --workspace apps/web",
    "format": "prettier --write .",
    "fixtures": "vite-node scripts/generateRenderPlanFixtures.ts",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^10.13.0",
    "prettier": "^3.9.6",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.4.3",
    "vite-node": "^3.2.4",
    "vitest": "^3.2.7"
  }
}
